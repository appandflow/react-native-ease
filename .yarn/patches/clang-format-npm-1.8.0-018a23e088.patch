+function isExecutableFile(file) {
+  try {
+    if (!fs.statSync(file).isFile()) return false;
+    fs.accessSync(file, fs.constants.X_OK);
+    return true;
+  } catch (e) {
+    return false;
+  }
+}
+
+/**
+ * @returns true when the file starts with a `#!` shebang, i.e. it is a script and not a native
+ * binary. Package manager shims (including this package's own `.bin` entry) are scripts that end up
+ * calling this file again, so they must never be picked as the fallback binary.
+ */
+function isScript(file) {
+  let fd;
+  try {
+    fd = fs.openSync(file, 'r');
+    const buf = Buffer.alloc(2);
+    const read = fs.readSync(fd, buf, 0, 2, 0);
+    return read === 2 && buf.toString('latin1') === '#!';
+  } catch (e) {
+    return true;
+  } finally {
+    if (fd !== undefined) fs.closeSync(fd);
+  }
+}
+
+/**
+ * @returns the path of a system clang-format binary, or null when none is found
+ */
+function findSystemBinary() {
+  const fromEnv = process.env.CLANG_FORMAT_BINARY;
+  if (fromEnv) {
+    if (isExecutableFile(fromEnv)) {
+      return fromEnv;
+    }
+    throw new Error(`CLANG_FORMAT_BINARY is set to '${fromEnv}', which is not an executable file.\n`);
+  }
+
+  const exeName = os.platform() === 'win32' ? 'clang-format.exe' : 'clang-format';
+  const dirs = (process.env.PATH || '').split(path.delimiter).filter(Boolean);
+  for (const dir of dirs) {
+    if (dir.split(/[\\/]/).includes('node_modules')) continue;
+    const candidate = path.join(dir, exeName);
+    if (!isExecutableFile(candidate)) continue;
+    // Skip shims, including the temporary wrapper directories package managers put on PATH.
+    if (path.basename(fs.realpathSync(candidate)) === 'index.js' || isScript(candidate)) continue;
+    return candidate;
+  }
+  return null;
+}
+
+function warnOnVersionMismatch(binary) {
+  // The bundled binaries are clang-format 13.0.1; other versions format differently.
+  const expected = '13.0.1';
+  try {
+    const out = require('child_process').spawnSync(binary, ['--version'], {encoding: 'utf8'});
+    const match = /version (\d+\.\d+\.\d+)/.exec(out.stdout || '');
+    if (!match || match[1] !== expected) {
+      console.error(
+          `warning: using ${binary} (${match ? match[1] : 'unknown version'}); ` +
+          `this project expects clang-format ${expected}, other versions may format differently.`);
+    }
+  } catch (e) {
+    // Ignore; spawning the binary later reports any real error.
+  }
+}
